# SEM6000 bridge settings. Install as /etc/homeautomation/sem6000-wrapper-<instance>.env, root:root 0600
# (systemd reads it as root via EnvironmentFile=). For manual runs: sem6000-wrapper.py -e FILE.
# Values may be quoted. No variable interpolation: '$' is taken literally.

# --- Meters ----------------------------------------------------------------------------------
# Comma-separated MAC=PIN pairs. The PIN is the 4-digit pin of the meter (default 0000).
SEM6000_METERS=00:11:22:33:44:55=0000
# Seconds between readings (5..3600).
SEM6000_INTERVAL=10
SEM6000_BLUETOOTH_ADAPTER=hci0
# Power readings and energy counters above this (+10%) are treated as garbage.
# The SEM6000 is rated 16 A / 3680 W.
SEM6000_MAX_POWER_W=3680
# Allow switching the relay from Home Assistant / MQTT. false = read-only binary sensor.
SEM6000_ALLOW_SWITCHING=true
# Home Assistant entity ids to use when the entities are first created, e.g. to keep the history of
# sensors from configuration.yaml (see README.md). Comma-separated [MAC/]key=entity_id; the MAC may be
# left out with a single meter. Keys: power, voltage, current, frequency, power_factor, energy_today, relay.
#SEM6000_ENTITY_IDS=energy_today=sensor.heatpump_today,power=sensor.heatpump_power
# Instance name, used in MQTT topics and the client id. The systemd unit sets it to %i;
# with -e it defaults to the file name without '.env' and 'sem6000-wrapper-' (sem6000-wrapper-heatpump.env -> heatpump).
#SEM6000_INSTANCE=heatpump

# --- MQTT (required) -------------------------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=sem6000
MQTT_PASSWORD='change me'
# Must be unique per instance; default: sem6000-<instance>-<hostname>
#MQTT_CLIENT_ID=
MQTT_TOPIC=energymeter
MQTT_SWITCHTOPIC=switches/sem6000

# --- Home Assistant MQTT discovery -----------------------------------------------------------
HA_DISCOVERY=true
HA_DISCOVERY_PREFIX=homeassistant

# --- InfluxDB 1.x (optional: leave INFLUXDB_HOST empty to disable) ---------------------------
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_SSL=false
INFLUXDB_USERNAME=sem6000
INFLUXDB_PASSWORD='change me'
INFLUXDB_DATABASE=slimmemeter
INFLUXDB_SERIES=energymeter
# Points kept in memory while InfluxDB is unreachable (~29 days for one meter at a 10 s interval).
INFLUXDB_MAX_QUEUE=250000
